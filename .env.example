# RecOsuk frontend env — copy this file to `.env` and fill in your values.
# (Never commit a real .env; it is git-ignored.)
#
# Find both values in your Supabase project: Settings → API.
# The anon key is PUBLIC-safe by design — Row Level Security is what
# protects the data, not secrecy of this key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put these in the frontend env:
# - the Supabase service-role key (bypasses RLS — server/CLI use only)
# - OSU_CLIENT_ID / OSU_CLIENT_SECRET (they live as secrets on the
#   osu-proxy Edge Function — see docs/M1-SETUP.md)
